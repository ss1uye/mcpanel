{
  "name": "mcpanel",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @mcpanel/web && npm run build -w @mcpanel/server",
    "start": "node apps/server/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/clean-e2e.mjs && playwright test",
    "release:portable": "npm run build && node scripts/package-portable.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs",
    "desktop:payload": "node scripts/prepare-desktop-payload.mjs",
    "desktop:build": "npm run build -w @mcpanel/desktop",
    "desktop:package": "npm run build && npm run desktop:payload && npm run desktop:build && npm run package -w @mcpanel/desktop",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "test:e2e:desktop": "playwright test --config playwright.desktop.config.ts",
    "release:desktop": "npm run desktop:package && npm run test:e2e:desktop && npm run smoke:desktop && node scripts/release-checksums.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "argon2": true,
    "better-sqlite3": true,
    "electron-winstaller": true,
    "esbuild": true,
    "fsevents": true
  }
}
